<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>LaserGun</AssemblyName>
    <RootNamespace>LaserGun</RootNamespace>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>1.1.0</Version>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <NoWarn>CS0436;CS8632;CS1701;CS1702;MSB3277;MSB3243</NoWarn>
  </PropertyGroup>

  <!--
    Point this at your game. BepInEx (IL2CPP) must have run once so BepInEx\interop exists.
      dotnet build -c Release -p:GameDir="D:\SteamLibrary\steamapps\common\ZED ZONE"
  -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\ZED ZONE</GameDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(GameDir)\BepInEx</BepInExDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(BepInExDir)\core\*.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\*.dll" Exclude="$(BepInExDir)\interop\UnityEngine.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\pack.png" LogicalName="LaserGun.pack.png" />
    <EmbeddedResource Include="Resources\rifle_loaded.png" LogicalName="LaserGun.rifle_loaded.png" />
  </ItemGroup>
</Project>
